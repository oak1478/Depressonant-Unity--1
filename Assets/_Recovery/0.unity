  - choiceButtonText: "\"...\u0E04\u0E48\u0E30\""
    stressChange: 0
    nextDialogueLines: []
  - choiceButtonText: "\"\u0E41\u0E25\u0E49\u0E27\u0E41\u0E21\u0E48\u0E44\u0E1B\u0E44\u0E2B\u0E19\u0E21\u0E32\u0E2B\u0E23\u0E2D\u0E04\u0E30?\" "

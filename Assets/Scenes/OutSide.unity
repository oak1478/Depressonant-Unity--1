      value: "\u0E2E\u0E30\u0E2E\u0E32\u0E2E\u0E32 \u0E2A\u0E07\u0E2A\u0E31\u0E22\u0E09\u0E31\u0E19\u0E08\u0E30\u0E41\u0E01\u0E48\u0E41\u0E25\u0E49\u0E27\u0E08\u0E23\u0E34\u0E07\u0E46"

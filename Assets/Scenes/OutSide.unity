      propertyPath: dialoguesByDay.Array.data[0].introductionStory.Array.data[4].text
      value: "\u0E41\u0E15\u0E48\u0E01\u0E47\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35\u0E04\u0E48\u0E30"

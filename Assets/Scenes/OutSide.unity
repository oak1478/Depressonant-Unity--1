      propertyPath: dialoguesByDay.Array.data[0].introductionStory.Array.data[1].text
      value: "\u0E40\u0E2D\u0E4A\u0E30!"
      objectReference: {fileID: 0}
    - target: {fileID: 1394120123608294190, guid: 11503781e05c43c4eb2475c4fa334912, type: 3}
      propertyPath: dialoguesByDay.Array.data[0].introductionStory.Array.data[2].text
      value: "\u0E2B\u0E23\u0E37\u0E2D\u0E27\u0E48\u0E32\u0E09\u0E31\u0E19\u0E08\u0E33\u0E1C\u0E34\u0E14
        \u0E2B\u0E19\u0E39\u0E40\u0E23\u0E19\u0E23\u0E36\u0E40\u0E1B\u0E25\u0E48\u0E32\u0E19\u0E30?"
      objectReference: {fileID: 0}
    - target: {fileID: 1394120123608294190, guid: 11503781e05c43c4eb2475c4fa334912, type: 3}
      propertyPath: dialoguesByDay.Array.data[0].introductionStory.Array.data[3].text
      value: "\u0E1B\u0E49\u0E32\u0E1E\u0E39\u0E14\u0E2D\u0E30\u0E44\u0E23\u0E19\u0E48\u0E30\u0E1B\u0E49\u0E32\u0E08\u0E34\u0E19

    - portraitName: "\u0E40\u0E01\u0E48\u0E32"
      sprite: {fileID: 21300000, guid: 71eecaf9cba9f4c4cb720dc569d2a485, type: 3}
  - npcName: "\u0E1B\u0E49\u0E32\u0E08\u0E34\u0E19"
    portraits:
    - portraitName: 1
      sprite: {fileID: 21300000, guid: c7b3b1ea5f99c7845aaedd12e9fc8c28, type: 3}
  dialoguesByDay:
  - dayTitle: DAY 2
    dayNumber: 2
    introductionStory:
    - text: "\u0E2B\u0E37\u0E2D ? "
      speakerName: "\u0E40\u0E19\u0E35\u0E22"
      portraitName: 1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 3
    - text: "\u0E2D\u0E49\u0E32\u0E27 \u0E40\u0E19\u0E35\u0E22! \u0E15\u0E37\u0E48\u0E19\u0E2A\u0E32\u0E22\u0E40\u0E0A\u0E35\u0E22\u0E27\u0E19\u0E30\u0E27\u0E31\u0E19\u0E19\u0E35\u0E49"
      speakerName: "\u0E1B\u0E49\u0E32\u0E08\u0E34\u0E19"
      portraitName: 1
      stressChange: 0
      otherName: 
      activeSlotIndex: 7
      motionEffect: 0
    - text: "\u0E40\u0E2D\u0E4A\u0E30!"
      speakerName: "\u0E1B\u0E49\u0E32\u0E08\u0E34\u0E19"
      portraitName: 1
      stressChange: 0
      otherName: 
      activeSlotIndex: 7
      motionEffect: 0
    - text: "\u0E2B\u0E23\u0E37\u0E2D\u0E27\u0E48\u0E32\u0E09\u0E31\u0E19\u0E08\u0E33\u0E1C\u0E34\u0E14
        \u0E2B\u0E19\u0E39\u0E40\u0E23\u0E19\u0E23\u0E36\u0E40\u0E1B\u0E25\u0E48\u0E32\u0E19\u0E30?"
      speakerName: "\u0E1B\u0E49\u0E32\u0E08\u0E34\u0E19"
      portraitName: 1
      stressChange: 0
      otherName: 
      activeSlotIndex: 7
      motionEffect: 0
    - text: "\u0E1B\u0E49\u0E32\u0E1E\u0E39\u0E14\u0E2D\u0E30\u0E44\u0E23\u0E19\u0E48\u0E30\u0E1B\u0E49\u0E32\u0E08\u0E34\u0E19
        ?"
      speakerName: "\u0E40\u0E19\u0E35\u0E22"
      portraitName: 1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
    - text: "\u0E41\u0E15\u0E48\u0E01\u0E47\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35\u0E04\u0E48\u0E30"
      speakerName: "\u0E40\u0E19\u0E35\u0E22"
      portraitName: 1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
    - text: "\u0E2E\u0E30\u0E2E\u0E32\u0E2E\u0E32 \u0E2A\u0E07\u0E2A\u0E31\u0E22\u0E09\u0E31\u0E19\u0E08\u0E30\u0E41\u0E01\u0E48\u0E41\u0E25\u0E49\u0E27\u0E08\u0E23\u0E34\u0E07\u0E46"
      speakerName: "\u0E1B\u0E49\u0E32\u0E08\u0E34\u0E19"
      portraitName: 1
      stressChange: 0
      otherName: 
      activeSlotIndex: 7
      motionEffect: 0
    storyChoices:
    - choiceButtonText: "\u0E2B\u0E19\u0E39\u0E21\u0E35\u0E19\u0E49\u0E2D\u0E07\u0E2A\u0E32\u0E27\u0E0A\u0E37\u0E48\u0E2D\u0E40\u0E23\u0E19\u0E44\u0E07\u0E04\u0E48\u0E30
        \u0E1B\u0E49\u0E32\u0E25\u0E37\u0E21\u0E41\u0E25\u0E49\u0E27\u0E2B\u0E23\u0E2D"
      stressChange: 0
      speakerName: "\u0E40\u0E19\u0E35\u0E22"
      portraitName: 1
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      nextDialogueLines:
      - text: "\u0E07\u0E31\u0E49\u0E19\u0E2B\u0E23\u0E2D \u0E09\u0E31\u0E19\u0E04\u0E07\u0E40\u0E2B\u0E47\u0E19\u0E19\u0E49\u0E2D\u0E07\u0E40\u0E23\u0E19\u0E19\u0E31\u0E49\u0E19\u0E1A\u0E48\u0E2D\u0E22\u0E01\u0E27\u0E48\u0E32\u0E41\u0E01\u0E25\u0E30\u0E19\u0E30"
        speakerName: "\u0E1B\u0E49\u0E32\u0E08\u0E34\u0E19"
        portraitName: 1
        stressChange: 0
        otherName: 
        activeSlotIndex: 7
        motionEffect: 0
      - text: "\u0E01\u0E47\u0E41\u0E01\u0E19\u0E30 \u0E40\u0E19\u0E35\u0E22\r\n"
        speakerName: "\u0E1B\u0E49\u0E32\u0E08\u0E34\u0E19"
        portraitName: 1
        stressChange: 0
        otherName: 
        activeSlotIndex: 7
        motionEffect: 0
      - text: "\u0E40\u0E2D\u0E32\u0E41\u0E15\u0E48\u0E2B\u0E21\u0E01\u0E15\u0E31\u0E27\u0E2D\u0E22\u0E39\u0E48\u0E43\u0E19\u0E1A\u0E49\u0E32\u0E19
          \u0E44\u0E21\u0E48\u0E2D\u0E2D\u0E01\u0E21\u0E32\u0E2D\u0E32\u0E1A\u0E41\u0E2A\u0E07\u0E43\u0E2B\u0E49\u0E40\u0E2B\u0E47\u0E19\u0E40\u0E25\u0E22\u0E19\u0E34
          \u0E08\u0E19\u0E09\u0E31\u0E19\u0E25\u0E37\u0E21\u0E41\u0E01\u0E44\u0E1B\u0E25\u0E30"
        speakerName: "\u0E1B\u0E49\u0E32\u0E08\u0E34\u0E19"
        portraitName: 1
        stressChange: 5
        otherName: 
        activeSlotIndex: 7
        motionEffect: 0
      - text: "\u0E16\u0E49\u0E32\u0E44\u0E21\u0E48\u0E21\u0E35\u0E2D\u0E30\u0E44\u0E23\u0E41\u0E25\u0E49\u0E27\u0E2B\u0E19\u0E39\u0E02\u0E2D\u0E15\u0E31\u0E27\u0E01\u0E48\u0E2D\u0E19\u0E19\u0E30\u0E04\u0E48\u0E30"

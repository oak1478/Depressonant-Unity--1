  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraction
  npcDisplayName: Shia
  npcProfiles:
  - npcName: Nia
    portraits:
    - portraitName: idle
      sprite: {fileID: 21300000, guid: b0da9f997a1499241bb34209da311e78, type: 3}
    - portraitName: good1
      sprite: {fileID: 21300000, guid: 88ee9be14039d9445bce6b410415b08b, type: 3}
    - portraitName: bad1
      sprite: {fileID: 21300000, guid: 59425c8993e720149b1dd16d5f765aea, type: 3}
  - npcName: Shia
    portraits:
    - portraitName: idle
      sprite: {fileID: 21300000, guid: 5b754a00281c141408fe189ba37613c1, type: 3}
  - npcName: Hong
    portraits:
    - portraitName: idle
      sprite: {fileID: 21300000, guid: 2205c9e91fabbf045abde78df96e693c, type: 3}
  dialoguesByDay:
  - dayTitle: DAY 6
    dayNumber: 6
    introductionStory:
    - text: "อ้าว เนีย เดินหน้าซีดออกมาเชียว"
      speakerName: Shia
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
    - text: "การเจออะไรมาเหนื่อยขนาดนั้น?"
      speakerName: Hong
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 6
      motionEffect: 0
      voiceSoundName: 
    - text: "(ทำงานมาก? เจอเรื่องแย่ๆ? แต่ไม่ได้อยากโดนพวกเธอปลอบเลย)"
      speakerName: Nia
      portraitName: bad1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    - text: "เอาเถอะ เธอดูแลห้องสมุดด้วยหนิ เก่งแล้วละ"
      speakerName: Shia
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
    - text: "(ชมตามมารยาทล่ะสิ... สมเพชฉันอยู่ใช่ไหม? ปลอบใจเด็กห่วยๆ คนนึงอยู่สินะ)"
      speakerName: Nia
      portraitName: bad1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    - text: "หางานหาการทำก็ดีแล้ว ดีกว่านั่งซึมเป็นเป็ดหลงฝูงอยู่ในห้องเรียน"
      speakerName: Shia
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
    - text: "เชีย... พูดแรงไปแล้วนะ"
      speakerName: Hong
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 6
      motionEffect: 0
      voiceSoundName: 
    - text: "จริงนี่ วันๆ เอาแต่หมกตัวด้วย"
      speakerName: Shia
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
    - text: "นั่นสินะ ก็จริง!!"
      speakerName: Nia
      portraitName: bad1
      stressChange: 10
      otherName: 
      activeSlotIndex: 1
      motionEffect: 2
      voiceSoundName: 
    - text: "(ใช่... เชียพูดถูกแล้ว ฉันมันไร้ค่า ทำอะไรก็ล้มเหลว)"
      speakerName: Nia
      portraitName: bad1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    - text: "(ขยะ... ไร้ประโยชน์... อยากหายไปซะตอนนี้เลย)"
      speakerName: Nia
      portraitName: bad1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    storyChoices:
    - choiceButtonText: "(นิ่งเงียบ)"
      stressChange: 10
      speakerName: Nia
      portraitName: bad1
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
      nextDialogueLines: []
    - choiceButtonText: "พวกเธอจะไปเข้าใจอะไรล่ะ!"
      stressChange: -15
      speakerName: Nia
      portraitName: good1
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
      nextDialogueLines:
      - text: "เหรอ? งั้นก็ทำให้ดูสิว่าเข้าใจอะไรบ้าง!"
        speakerName: Shia
        portraitName: idle
        stressChange: 0
        otherName: 
        activeSlotIndex: 4
        motionEffect: 0
        voiceSoundName: 
    - choiceButtonText: "ขอโทษนะ..."
      stressChange: 5
      speakerName: Nia
      portraitName: bad1
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
      nextDialogueLines: []
    conclusionStory:
    - text: "(ออกมาดีกว่า)"
      speakerName: Nia
      portraitName: bad1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    - text: "หนีซะละ"
      speakerName: Shia
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
  - dayTitle: DAY 7
    dayNumber: 7
    introductionStory:
    - text: "\u0E40\u0E2B\u0E2D\u0E30 \u0E21\u0E32\u0E2A\u0E32\u0E22\u0E15\u0E32\u0E21\u0E40\u0E04\u0E22
        \u0E04\u0E34\u0E14\u0E27\u0E48\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E40\u0E14\u0E47\u0E01\u0E42\u0E1B\u0E23\u0E14\u0E04\u0E23\u0E39\u0E42\u0E21\u0E21\u0E48\u0E2D\u0E19\u0E41\u0E25\u0E49\u0E27\u0E08\u0E30\u0E17\u0E33\u0E2D\u0E30\u0E44\u0E23\u0E01\u0E47\u0E44\u0E14\u0E49\u0E2B\u0E23\u0E37\u0E2D\u0E44\u0E07?"
      speakerName: Shia
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E0A\u0E35\u0E2D\u0E48\u0E32 \u0E1E\u0E2D\u0E01\u0E48\u0E2D\u0E19\u0E40\u0E16\u0E2D\u0E30
        \u0E40\u0E19\u0E35\u0E22\u0E40\u0E02\u0E32\u0E04\u0E07\u0E21\u0E35\u0E40\u0E2B\u0E15\u0E38\u0E1C\u0E25\u0E02\u0E2D\u0E07\u0E40\u0E02\u0E32"
      speakerName: Hong
      portraitName: 
      stressChange: 0
      otherName: 
      activeSlotIndex: 6
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E40\u0E2B\u0E15\u0E38\u0E1C\u0E25\u0E2D\u0E30\u0E44\u0E23? \u0E19\u0E31\u0E48\u0E07\u0E17\u0E33\u0E2B\u0E19\u0E49\u0E32\u0E0B\u0E36\u0E21\u0E40\u0E1B\u0E47\u0E19\u0E20\u0E32\u0E23\u0E30\u0E04\u0E19\u0E2D\u0E37\u0E48\u0E19\u0E44\u0E1B\u0E27\u0E31\u0E19\u0E46
        \u0E40\u0E19\u0E35\u0E22\u0E40\u0E19\u0E35\u0E48\u0E22\u0E19\u0E30?"
      speakerName: Shia
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E07\u0E32\u0E19\u0E01\u0E25\u0E38\u0E48\u0E21\u0E04\u0E23\u0E32\u0E27\u0E17\u0E35\u0E48\u0E41\u0E25\u0E49\u0E27\u0E01\u0E47\u0E17\u0E33\u0E0A\u0E49\u0E32
        \u0E08\u0E19\u0E04\u0E19\u0E2D\u0E37\u0E48\u0E19\u0E40\u0E02\u0E32\u0E15\u0E49\u0E2D\u0E07\u0E21\u0E32\u0E15\u0E32\u0E21\u0E41\u0E01\u0E49\u0E43\u0E2B\u0E49"
      speakerName: Shia
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E04\u0E19\u0E44\u0E23\u0E49\u0E1B\u0E23\u0E30\u0E42\u0E22\u0E0A\u0E19\u0E4C\u0E41\u0E1A\u0E1A\u0E40\u0E18\u0E2D
        \u0E21\u0E31\u0E19\u0E40\u0E04\u0E22\u0E17\u0E33\u0E2D\u0E30\u0E44\u0E23\u0E2A\u0E33\u0E40\u0E23\u0E47\u0E08\u0E1A\u0E49\u0E32\u0E07\u0E16\u0E32\u0E21\u0E08\u0E23\u0E34\u0E07?"
      speakerName: Shia
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
    - text: '!!'
      speakerName: Nia
      portraitName: bad1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 2
      voiceSoundName: 
    - text: "(\u0E44\u0E23\u0E49\u0E1B\u0E23\u0E30\u0E42\u0E22\u0E0A\u0E19\u0E4C...)"
      speakerName: Nia
      portraitName: bad1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    - text: "(\u0E04\u0E33\u0E04\u0E33\u0E19\u0E35\u0E49\u0E1B\u0E25\u0E38\u0E01
        Hippocampus \u0E43\u0E19\u0E2B\u0E31\u0E27\u0E02\u0E36\u0E49\u0E19\u0E21\u0E32\u0E17\u0E27\u0E19\u0E04\u0E27\u0E32\u0E21\u0E08\u0E33...)"
      speakerName: Nia
      portraitName: bad1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    - text: "(\u0E09\u0E32\u0E01\u0E04\u0E27\u0E32\u0E21\u0E25\u0E49\u0E21\u0E40\u0E2B\u0E25\u0E27\u0E40\u0E01\u0E48\u0E32\u0E46
        \u0E1E\u0E23\u0E31\u0E48\u0E07\u0E1E\u0E23\u0E39\u0E2D\u0E2D\u0E01\u0E21\u0E32\u0E44\u0E21\u0E48\u0E2B\u0E22\u0E38\u0E14
        \u0E20\u0E32\u0E1E\u0E40\u0E01\u0E23\u0E14\u0E15\u0E01 \u0E20\u0E32\u0E1E\u0E42\u0E14\u0E19\u0E41\u0E21\u0E48\u0E1A\u0E48\u0E19
        \u0E20\u0E32\u0E1E\u0E17\u0E33\u0E02\u0E27\u0E14\u0E41\u0E01\u0E49\u0E27\u0E17\u0E14\u0E25\u0E2D\u0E07\u0E41\u0E15\u0E01\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E40\u0E17\u0E2D\u0E21\u0E01\u0E48\u0E2D\u0E19...)"
      speakerName: Nia
      portraitName: bad1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    - text: "(\u0E09\u0E32\u0E22\u0E0B\u0E49\u0E33\u0E44\u0E1B\u0E0B\u0E49\u0E33\u0E21\u0E32
        \u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E20\u0E32\u0E1E\u0E22\u0E19\u0E15\u0E23\u0E4C\u0E17\u0E35\u0E48\u0E44\u0E21\u0E48\u0E21\u0E35\u0E27\u0E31\u0E19\u0E08\u0E1A)"
      speakerName: Nia
      portraitName: bad1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    - text: "(\u0E08\u0E23\u0E34\u0E07\u0E14\u0E49\u0E27\u0E22... \u0E40\u0E23\u0E32\u0E44\u0E21\u0E48\u0E40\u0E04\u0E22\u0E17\u0E33\u0E2D\u0E30\u0E44\u0E23\u0E2A\u0E33\u0E40\u0E23\u0E47\u0E08\u0E40\u0E25\u0E22\u0E2A\u0E31\u0E01\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E15\u0E31\u0E49\u0E07\u0E41\u0E15\u0E48\u0E40\u0E01\u0E34\u0E14\u0E21\u0E32)"
      speakerName: Nia
      portraitName: bad1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    - text: "(\u0E16\u0E49\u0E32\u0E15\u0E31\u0E27\u0E40\u0E23\u0E32\u0E21\u0E31\u0E19\u0E44\u0E23\u0E49\u0E04\u0E48\u0E32\u0E41\u0E25\u0E30\u0E40\u0E1B\u0E47\u0E19\u0E20\u0E32\u0E23\u0E30\u0E02\u0E19\u0E32\u0E14\u0E19\u0E35\u0E49...
        \u0E41\u0E25\u0E49\u0E27\u0E40\u0E23\u0E32\u0E08\u0E30\u0E40\u0E01\u0E34\u0E14\u0E21\u0E32\u0E17\u0E33\u0E44\u0E21?)"
      speakerName: Nia
      portraitName: bad1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    storyChoices:
    - choiceButtonText: "\u0E02\u0E2D\u0E42\u0E17\u0E29... \u0E17\u0E35\u0E48\u0E09\u0E31\u0E19\u0E21\u0E31\u0E19\u0E44\u0E23\u0E49\u0E1B\u0E23\u0E30\u0E42\u0E22\u0E0A\u0E19\u0E4C"

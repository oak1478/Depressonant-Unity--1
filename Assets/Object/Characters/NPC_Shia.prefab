    introductionStory:
    - text: "\u0E40\u0E2B\u0E2D\u0E30 \u0E23\u0E34\u0E19\u0E2D\u0E27\u0E22\u0E22\u0E28\u0E43\u0E2B\u0E49\u0E02\u0E19\u0E32\u0E14\u0E19\u0E31\u0E49\u0E19

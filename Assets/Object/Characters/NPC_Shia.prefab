      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E40\u0E18\u0E2D\u0E23\u0E39\u0E49\u0E15\u0E31\u0E27\u0E1A\u0E49\u0E32\u0E07\u0E44\u0E2B\u0E21\u0E27\u0E48\u0E32\u0E40\u0E18\u0E2D\u0E40\u0E1B\u0E47\u0E19\u0E15\u0E31\u0E27\u0E14\u0E39\u0E14\u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19\u0E04\u0E19\u0E2D\u0E37\u0E48\u0E19?

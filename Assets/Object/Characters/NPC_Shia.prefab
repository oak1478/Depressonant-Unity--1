      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E1C\u0E48\u0E32\u0E19\u0E40\u0E1E\u0E23\u0E32\u0E30\u0E23\u0E34\u0E19\u0E41\u0E17\u0E1A\u0E08\u0E30\u0E1B\u0E49\u0E2D\u0E19\u0E40\u0E02\u0E49\u0E32\u0E1B\u0E32\u0E01\u0E43\u0E2B\u0E49\u0E44\u0E07!
        \u0E16\u0E49\u0E32\u0E44\u0E21\u0E48\u0E21\u0E35\u0E23\u0E34\u0E19\u0E04\u0E2D\u0E22\u0E1B\u0E23\u0E30\u0E04\u0E1A\u0E1B\u0E23\u0E30\u0E2B\u0E07\u0E21

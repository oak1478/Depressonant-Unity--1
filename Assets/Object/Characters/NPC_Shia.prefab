      nextDialogueLines: []
    - choiceButtonText: "\u0E40\u0E18\u0E2D\u0E40\u0E2D\u0E07\u0E01\u0E47\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E14\u0E35\u0E44\u0E1B\u0E01\u0E27\u0E48\u0E32\u0E09\u0E31\u0E19\u0E19\u0E31\u0E01\u0E2B\u0E23\u0E2D\u0E01!"

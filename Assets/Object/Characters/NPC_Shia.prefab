      voiceSoundName: 
      nextDialogueLines:
      - text: "\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E19\u0E49\u0E2D\u0E22\u0E09\u0E31\u0E19\u0E01\u0E47\u0E44\u0E21\u0E48\u0E19\u0E31\u0E48\u0E07\u0E44\u0E23\u0E49\u0E04\u0E48\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E02\u0E22\u0E30\u0E41\u0E1A\u0E1A\u0E40\u0E18\u0E2D\u0E01\u0E47\u0E41\u0E25\u0E49\u0E27\u0E01\u0E31\u0E19!"

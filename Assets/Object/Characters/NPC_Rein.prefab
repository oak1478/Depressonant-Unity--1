      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E1E\u0E35\u0E48\u0E40\u0E19\u0E35\u0E22... \u0E27\u0E31\u0E19\u0E19\u0E35\u0E49\u0E1A\u0E23\u0E23\u0E22\u0E32\u0E01\u0E32\u0E28\u0E15\u0E2D\u0E19\u0E01\u0E34\u0E19\u0E02\u0E49\u0E32\u0E27\u0E40\u0E0A\u0E49\u0E32

      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E2B\u0E19\u0E39\u0E02\u0E2D\u0E42\u0E17\u0E29\u0E19\u0E30\u0E1E\u0E35\u0E48\u0E40\u0E19\u0E35\u0E22...

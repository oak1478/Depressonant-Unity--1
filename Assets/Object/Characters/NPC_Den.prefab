        otherName: 
        activeSlotIndex: 4
        motionEffect: 0
        voiceSoundName: 
      - text: "\u0E41\u0E15\u0E48\u0E40\u0E2D\u0E32\u0E40\u0E16\u0E2D\u0E30 \u0E40\u0E23\u0E32\u0E21\u0E35\u0E1E\u0E35\u0E48\u0E40\u0E19\u0E35\u0E22\u0E2D\u0E22\u0E39\u0E48"

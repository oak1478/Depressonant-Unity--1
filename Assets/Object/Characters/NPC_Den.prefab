  dialoguesByDay:
  - dayTitle: DAY 2
    dayNumber: 2
    introductionStory:
    - text: "\u0E1E\u0E35\u0E48\u0E40\u0E19\u0E35\u0E22! \u0E21\u0E32\u0E40\u0E25\u0E48\u0E19\u0E14\u0E49\u0E27\u0E22\u0E01\u0E31\u0E19\u0E44\u0E2B\u0E21?
        \u0E40\u0E23\u0E32\u0E01\u0E33\u0E25\u0E31\u0E07\u0E02\u0E32\u0E14\u0E04\u0E19\u0E01\u0E31\u0E19\u0E2D\u0E22\u0E39\u0E48!"
      speakerName: Den
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 1
      voiceSoundName: 
    - text: "\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35\u0E40\u0E14\u0E19 \u0E41\u0E25\u0E49\u0E27\u0E21\u0E31\u0E19\u0E40\u0E25\u0E48\u0E19\u0E22\u0E31\u0E07\u0E44\u0E07\u0E19\u0E48\u0E30"
      speakerName: Nia
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E1E\u0E35\u0E48\u0E44\u0E21\u0E48\u0E23\u0E39\u0E49\u0E08\u0E31\u0E01\u0E2B\u0E23\u0E2D"
      speakerName: Den
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E07\u0E31\u0E49\u0E19\u0E01\u0E47\u0E41\u0E04\u0E48\u0E40\u0E23\u0E34\u0E48\u0E21\u0E40\u0E01\u0E21\u0E2A\u0E4C\u0E01\u0E48\u0E2D\u0E19
        \u0E17\u0E35\u0E48\u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E01\u0E47\u0E23\u0E39\u0E49\u0E40\u0E2D\u0E07"
      speakerName: Den
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E17\u0E31\u0E01\u0E17\u0E32\u0E22\u0E1E\u0E35\u0E48\u0E40\u0E02\u0E32\u0E14\u0E35
        \u0E46 \u0E2A\u0E34\u0E40\u0E14\u0E19!"
      speakerName: Sasha
      portraitName: 
      stressChange: 0
      otherName: 
      activeSlotIndex: 6
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E1E\u0E35\u0E48\u0E40\u0E02\u0E32\u0E2D\u0E38\u0E15\u0E2A\u0E48\u0E32\u0E2B\u0E4C\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35\u0E01\u0E48\u0E2D\u0E19\u0E19\u0E30"
      speakerName: Sasha
      portraitName: 
      stressChange: 0
      otherName: 
      activeSlotIndex: 6
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35\u0E04\u0E48\u0E30\u0E1E\u0E35\u0E48"
      speakerName: Sasha
      portraitName: 
      stressChange: 0
      otherName: 
      activeSlotIndex: 6
      motionEffect: 0
      voiceSoundName: 
    - text: ...
      speakerName: Sasha
      portraitName: 
      stressChange: 0
      otherName: 
      activeSlotIndex: 6
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E1E\u0E35\u0E48\u0E0A\u0E37\u0E48\u0E2D\u0E2D\u0E30\u0E44\u0E23\u0E19\u0E30\u0E04\u0E48\u0E30"
      speakerName: Sasha
      portraitName: 
      stressChange: 0
      otherName: 
      activeSlotIndex: 6
      motionEffect: 0
      voiceSoundName: 
    - text: "(\u0E40\u0E08\u0E49\u0E32\u0E40\u0E14\u0E47\u0E01\u0E19\u0E35\u0E48!)"
      speakerName: Nia
      portraitName: bad1
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E1E\u0E35\u0E48\u0E40\u0E19\u0E35\u0E22\u0E40\u0E2D\u0E07 \u0E0B\u0E32\u0E0A\u0E48\u0E32"
      speakerName: Nia
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E04\u0E48\u0E30\u0E1E\u0E35\u0E48\u0E40\u0E19\u0E35\u0E22 \u0E27\u0E31\u0E19\u0E19\u0E35\u0E49\u0E21\u0E32\u0E41\u0E1B\u0E25\u0E01\u0E19\u0E30\u0E04\u0E30
        \u0E1B\u0E01\u0E15\u0E34\u0E44\u0E21\u0E48\u0E2D\u0E2D\u0E01\u0E21\u0E32\u0E02\u0E49\u0E32\u0E07\u0E19\u0E2D\u0E01\u0E19\u0E34
        \u0E41\u0E15\u0E48\u0E01\u0E47\u0E21\u0E32\u0E40\u0E25\u0E48\u0E19\u0E40\u0E01\u0E21\u0E01\u0E31\u0E19\u0E40\u0E16\u0E2D\u0E30\u0E04\u0E48\u0E30"
      speakerName: Sasha
      portraitName: 
      stressChange: 0
      otherName: 
      activeSlotIndex: 6
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E40\u0E23\u0E34\u0E48\u0E21\u0E40\u0E01\u0E21\u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E01\u0E47\u0E40\u0E25\u0E48\u0E19\u0E40\u0E1B\u0E47\u0E19\u0E40\u0E2D\u0E07\u0E04\u0E48\u0E30"
      speakerName: Sasha
      portraitName: 
      stressChange: 0
      otherName: 
      activeSlotIndex: 6
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E40\u0E2D\u0E2D"
      speakerName: Egon
      portraitName: 
      stressChange: 0
      otherName: 
      activeSlotIndex: 7
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35\u0E04\u0E23\u0E31\u0E1A"
      speakerName: Egon
      portraitName: 
      stressChange: 0
      otherName: 
      activeSlotIndex: 7
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35"
      speakerName: Nia
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E07\u0E31\u0E49\u0E19 \u0E09\u0E31\u0E19\u0E40\u0E25\u0E48\u0E19\u0E14\u0E49\u0E27\u0E22\u0E01\u0E47\u0E44\u0E14\u0E49"
      speakerName: Nia
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E40\u0E23\u0E19\u0E25\u0E48\u0E30\u0E04\u0E23\u0E31\u0E1A? \u0E1B\u0E01\u0E15\u0E34\u0E2D\u0E2D\u0E01\u0E21\u0E32\u0E40\u0E25\u0E48\u0E19\u0E01\u0E31\u0E1A\u0E40\u0E23\u0E32\u0E15\u0E25\u0E2D\u0E14\u0E40\u0E25\u0E22\u0E19\u0E30"
      speakerName: Den
      portraitName: idle
      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
    storyChoices:
    - choiceButtonText: "\u0E40\u0E23\u0E19\u0E22\u0E38\u0E48\u0E07\u0E2D\u0E22\u0E39\u0E48\u0E19\u0E48\u0E30"
      stressChange: 0
      speakerName: Nia
      portraitName: idle
      otherName: 
      activeSlotIndex: 1
      motionEffect: 0
      voiceSoundName: 
      nextDialogueLines:
      - text: "\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E01\u0E35\u0E49\u0E22\u0E31\u0E07\u0E40\u0E2B\u0E47\u0E19\u0E19\u0E31\u0E48\u0E07\u0E14\u0E39\u0E17\u0E35\u0E27\u0E35\u0E2D\u0E22\u0E39\u0E48"
        speakerName: Nia
        portraitName: idle
        stressChange: 0
        otherName: 
        activeSlotIndex: 1
        motionEffect: 0
        voiceSoundName: 
      - text: "\u0E27\u0E31\u0E19\u0E19\u0E35\u0E49\u0E02\u0E22\u0E31\u0E19\u0E1C\u0E34\u0E14\u0E1B\u0E01\u0E15\u0E34\u0E41\u0E2E\u0E30"
        speakerName: Den

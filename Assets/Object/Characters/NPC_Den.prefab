        stressChange: 0
        otherName: 
        activeSlotIndex: 4
        motionEffect: 0
        voiceSoundName: 
      - text: "\u0E16\u0E49\u0E32\u0E19\u0E32\u0E07\u0E21\u0E32\u0E40\u0E25\u0E48\u0E19\u0E14\u0E49\u0E27\u0E22\u0E01\u0E47\u0E2A\u0E19\u0E38\u0E01\u0E01\u0E27\u0E48\u0E32\u0E19\u0E35\u0E49"

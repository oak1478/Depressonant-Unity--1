      portraitName: 1
      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 3
      voiceSoundName: 
    - text: "\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E04\u0E37\u0E19\u0E40\u0E25\u0E48\u0E19\u0E40\u0E01\u0E21\u0E2D\u0E35\u0E01\u0E41\u0E25\u0E49\u0E27\u0E40\u0E23\u0E2D\u0E30
        \u0E40\u0E2E\u0E49\u0E2D~~ \u0E41\u0E25\u0E49\u0E27\u0E41\u0E15\u0E48\u0E40\u0E16\u0E2D"

        motionEffect: 0
        voiceSoundName: 
    conclusionStory:
    - text: "\u0E41\u0E25\u0E49\u0E27\u0E40\u0E23\u0E19\u0E25\u0E48\u0E30 ? \u0E16\u0E49\u0E32\u0E1E\u0E48\u0E2D\u0E44\u0E21\u0E48\u0E44\u0E1B\u0E23\u0E31\u0E1A\u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E2B\u0E19\u0E39\u0E44\u0E1B\u0E40\u0E2D\u0E07"

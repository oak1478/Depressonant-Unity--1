      stressChange: 0
      otherName: 
      activeSlotIndex: 4
      motionEffect: 0
      voiceSoundName: 
    - text: "\u0E44\u0E14\u0E49\u0E04\u0E48\u0E30 \u0E41\u0E25\u0E49\u0E27\u0E19\u0E49\u0E2D\u0E07\u0E2D\u0E22\u0E39\u0E48\u0E44\u0E2B\u0E19\u0E04\u0E30"
